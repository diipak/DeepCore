<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deepcore.youtube-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/sync_youtube.sh</string>
    </array>

    <!-- Run twice daily: 12:00 AM (00:00) and 10:00 AM (10:00) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>__HOME__/.deepcore2/logs/youtube_sync.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.deepcore2/logs/youtube_sync.log</string>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
